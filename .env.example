PUBLIC_URL=http://localhost:8080
EXTERNAL_UI_URL=http://localhost:3000
HYDRA_ADMIN_URL=http://localhost:4445
HYDRA_PUBLIC_URL=http://localhost:4444
KRATOS_PUBLIC_URL=http://localhost:4433
KRATOS_SESSION_COOKIE=ory_kratos_session
REQUIRED_AAL=aal2
TRANSACTION_TTL=5m
MAX_PENDING_TRANSACTIONS=10000
ALLOWED_CLIENTS={}
ALLOWED_SUBJECTS=
ALLOWED_SUBJECT_SCOPES={}
POLICY_BACKEND=static
POLICY_URL=
POLICY_AUTH_TOKEN=
HYDRA_ADMIN_TOKEN=
ENVIRONMENT=development

# Redis is recommended for local multi-process and deployment use.
STATE_STORE=redis
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=hydra-kratos-login-consent:transaction:

# Production must use https:// URLs, rediss:// Redis, an environment-specific
# Redis prefix, Hydra admin authentication, and explicit subject/client scope
# rules. Example scope rules:
# {"operator-1":{"example-client":["openid","profile"]}}
