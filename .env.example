LISTEN_ADDR=:8080
LOG_LEVEL=info
PUBLIC_URL=http://localhost:8080
EXTERNAL_UI_URL=http://localhost:3000
HYDRA_ADMIN_URL=http://localhost:4445
HYDRA_PUBLIC_URL=http://localhost:4444
KRATOS_PUBLIC_URL=http://localhost:4433
KRATOS_SESSION_COOKIE=ory_kratos_session
REQUIRED_AAL=aal2
TRANSACTION_TTL=5m
MAX_PENDING_TRANSACTIONS=10000
MAX_CHALLENGE_LENGTH=2048
ALLOWED_CLIENTS={}
OIDC_IDENTITY_CLAIM_MAPPINGS=
ALLOWED_SUBJECTS=
ALLOWED_SUBJECT_SCOPES={}
POLICY_BACKEND=static
POLICY_URL=
POLICY_AUTH_TOKEN=
HYDRA_ADMIN_TOKEN=
ENVIRONMENT=development

# This is a development example. Empty client and subject values deny flows
# until they are replaced with the local application's generic test values.
# See docs/configuration.md for the exact JSON allowlist shape.

# Redis is used here so the local setup exercises shared transaction state.
# Production and replicas require Redis/Valkey with rediss://.
STATE_STORE=redis
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=hydra-kratos-login-consent:transaction:

# Secure static policy deployments require non-empty ALLOWED_SUBJECT_SCOPES.
# Secure HTTP policy deployments use POLICY_URL and POLICY_AUTH_TOKEN instead;
# ALLOWED_SUBJECT_SCOPES is not used in that mode.
